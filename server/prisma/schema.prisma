generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoardGame {
  id          Int      @id @default(autoincrement())
  title       String
  minPlayers  Int
  maxPlayers  Int
  description String?
  createdAt   DateTime @default(now())
}

model Player {
  id        Int @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}
