generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoardGame {
  id          Int      @id @default(autoincrement())
  title       String
  minPlayers  Int
  maxPlayers  Int
  description String?
  createdAt   DateTime @default(now())
  plays       Play[]

  // BoardGameGeek data, null for games entered by hand
  bggId         Int?      @unique
  yearPublished Int?
  playingTime   Int? // minutes
  thumbnailUrl  String?
  imageUrl      String?
  bggRating     Float?
  bggSyncedAt   DateTime?
}

model Player {
  id         Int               @id @default(autoincrement())
  name       String
  createdAt  DateTime          @default(now())
  gameNights GameNightPlayer[]
  scores     PlayScore[]
}

model GameNight {
  id        Int               @id @default(autoincrement())
  date      DateTime
  location  String?
  notes     String?
  createdAt DateTime          @default(now())
  players   GameNightPlayer[]
  plays     Play[]
}

model GameNightPlayer {
  gameNightId Int
  playerId    Int
  gameNight   GameNight @relation(fields: [gameNightId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([gameNightId, playerId])
}

model Play {
  id          Int         @id @default(autoincrement())
  gameNightId Int
  boardGameId Int
  createdAt   DateTime    @default(now())
  gameNight   GameNight   @relation(fields: [gameNightId], references: [id], onDelete: Cascade)
  boardGame   BoardGame   @relation(fields: [boardGameId], references: [id], onDelete: Restrict)
  scores      PlayScore[]
}

model PlayScore {
  playId   Int
  playerId Int
  score    Int
  play     Play   @relation(fields: [playId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([playId, playerId])
}
