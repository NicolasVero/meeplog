generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BoardGame {
  id          Int         @id @default(autoincrement())
  title       String
  minPlayers  Int
  maxPlayers  Int
  description String?
  createdAt   DateTime    @default(now())
  plays       Play[]
  ratings     Rating[]
  scoringMode ScoringMode @default(HIGHEST_WINS)

  // BoardGameGeek data, null for games entered by hand
  bggId         Int?      @unique
  yearPublished Int?
  playingTime   Int? // minutes
  thumbnailUrl  String?
  imageUrl      String?
  bggRating     Float?
  bggSyncedAt   DateTime?
}

model Player {
  id         Int               @id @default(autoincrement())
  name       String
  createdAt  DateTime          @default(now())
  gameNights GameNightPlayer[]
  scores     PlayScore[]
  ratings    Rating[]
}

model GameNight {
  id        Int               @id @default(autoincrement())
  date      DateTime
  location  String?
  notes     String?
  createdAt DateTime          @default(now())
  players   GameNightPlayer[]
  plays     Play[]
}

model GameNightPlayer {
  gameNightId Int
  playerId    Int
  gameNight   GameNight @relation(fields: [gameNightId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([gameNightId, playerId])
}

model Play {
  id          Int         @id @default(autoincrement())
  gameNightId Int
  boardGameId Int
  createdAt   DateTime    @default(now())
  gameNight   GameNight   @relation(fields: [gameNightId], references: [id], onDelete: Cascade)
  boardGame   BoardGame   @relation(fields: [boardGameId], references: [id], onDelete: Restrict)
  scores      PlayScore[]
}

model PlayScore {
  playId   Int
  playerId Int
  score    Int? // null for games without scores (winner only, cooperative)
  won      Boolean @default(false) // set by hand for winner-only and cooperative games
  play     Play    @relation(fields: [playId], references: [id], onDelete: Cascade)
  player   Player  @relation(fields: [playerId], references: [id], onDelete: Restrict)

  @@id([playId, playerId])
}

// A player's personal rating of a board game, from 1 to 10
model Rating {
  playerId    Int
  boardGameId Int
  value       Int
  updatedAt   DateTime  @updatedAt
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  boardGame   BoardGame @relation(fields: [boardGameId], references: [id], onDelete: Cascade)

  @@id([playerId, boardGameId])
}

// How the winner of a play is decided from the scores
enum ScoringMode {
  HIGHEST_WINS
  LOWEST_WINS
  WINNER_ONLY // no score: the winners are picked by hand
  COOPERATIVE // the whole team wins or loses together
}
